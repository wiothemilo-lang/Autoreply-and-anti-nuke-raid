{
  "name": "wio-bot",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -b --noEmit && tsc -p convex/tsconfig.json",
    "convex:dev": "convex dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node scripts/run-all-tests.cjs",
    "test:ts": "node scripts/run-all-tests.cjs --ts",
    "test:coverage": "c8 --config .c8rc.json node scripts/run-all-tests.cjs",
    "test:mutation": "node scripts/mutation-test.cjs --full",
    "coverage:floor": "node scripts/check-coverage-floor.cjs",
    "smoke:vps": "node scripts/smoke-vps.cjs",
    "check:payload": "node scripts/check-bot-payload.cjs --self-test",
    "check:ai-status": "node scripts/check-ai-status.cjs --self-test"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "convex": "^1.49.0",
    "framer-motion": "^11.11.10",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "7.18.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^2.5.4",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.6.2",
    "c8": "^12.0.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.4.3"
  }
}
