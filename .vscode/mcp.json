{
  "inputs": [
    {
      "type": "promptString",
      "id": "obsidian-api-key",
      "description": "Obsidian Local REST API key",
      "password": true
    }
  ],
  "servers": {
    "obsidian": {
      "type": "http",
      "url": "http://127.0.0.1:27123/mcp/",
      "headers": {
        "Authorization": "Bearer ${input:obsidian-api-key}"
      }
    }
  }
}
