# kiira-retry-proxy.service — chạy retry proxy như dịch vụ hệ thống (18/09/2026).
#
# Vì sao có unit này: tmux chỉ sống khi KHÔNG ai tắt nó — VPS reboot là mất,
# proxy crash thì nằm chết đến khi ai đó để ý. systemd tự khởi động cùng máy
# và TỰ CHẠY LẠI khi process chết (Restart=always) — đúng nghĩa "đừng ngắt quãng".
#
# Cài trên VPS (chạy 3 lệnh, lần đầu thôi):
#   cp "$REPO_DIR/scripts/kiira-retry-proxy.service" /etc/systemd/system/
#   systemctl daemon-reload
#   systemctl enable --now kiira-retry-proxy
#
# ⚠️ TRƯỚC KHI CÀI — sửa lại dòng ExecStart bên dưới cho KHỚP VPS của bạn:
#   1) đường dẫn `bun`  → lấy bằng `which bun` (mặc định /root/.bun/bin/bun)
#   2) đường dẫn repo   → ĐƯỜNG DẪN REPO KHÔNG CỐ ĐỊNH (bản cài theo
#      bot/VPS-DEPLOY.md nằm ở /opt/protogon; bản clone tay ở chỗ khác).
#      Cách tìm: docs/vps-security-hardening.md §0.
#   Unit này KHÔNG tự tìm repo — để sai đường dẫn là service chết ngay khi start.
#
# Kiểm tra:  systemctl status kiira-retry-proxy
# Xem log:   journalctl -u kiira-retry-proxy -f
#
# Sau khi bật systemd, có thể bỏ phiên tmux cũ (nếu còn) để tránh 2 proxy
# giành port 8787: tmux kill-session -t kiira 2>/dev/null || true

[Unit]
Description=Kiira retry proxy — chống chập chờn AI cho OpenCode (127.0.0.1:8787)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/root/.bun/bin/bun /root/Autoreply-and-anti-nuke-raid/scripts/kiira-retry-proxy.mjs
#                ↑ sửa 2 đường dẫn này theo VPS thật (xem ghi chú đầu tệp)
Restart=always
RestartSec=3
# Tự dừng và chạy lại nếu proxy treo không phản hồi.
WatchdogSec=0
# Chỉ loopback nên không cần quyền đặc biệt.
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
