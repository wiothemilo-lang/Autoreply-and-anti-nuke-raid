{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "share": "disabled",
  "env": {
    "AGENT_HISTORY_TTL_DAYS": "14",
    "OPENCODE_ENABLE_EXA": "1"
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true
    },
    "convex": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "convex@latest",
        "mcp",
        "start",
        "--project-dir",
        "/opt/Autoreply-and-anti-nuke-raid"
      ],
      "enabled": true
    }
  },
  "provider": {
    "revidapi": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "RevidAPI",
      "options": {
        "baseURL": "https://revidapi.com/v1",
        "apiKey": "{file:~/.secrets/revidapi-key}"
      },
      "models": {
        "claude-sonnet-5": {
          "name": "Claude Sonnet 5"
        },
        "claude-opus-5-5": {
          "name": "Claude Opus 5.5"
        },
        "claude-haiku-4-5": {
          "name": "Claude Haiku 4.5"
        },
        "gpt-6.1-sol": {
          "name": "GPT 6.1 Sol"
        },
        "gpt-6-sol": {
          "name": "GPT 6 Sol"
        },
        "gemini-3.8-flash": {
          "name": "Gemini 3.8 Flash"
        },
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash"
        },
        "kimi-k3": {
          "name": "Kimi K3"
        },
        "google/gemini-flash": {
          "name": "Gemini Flash (miễn phí)"
        }
      }
    },
    "kiira": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Kiira",
      "options": {
        "baseURL": "http://127.0.0.1:8787",
        "apiKey": "{file:~/.secrets/kiira-key}"
      },
      "models": {
        "qwen3.8-flash": {
          "name": "Qwen 3.8 Flash"
        },
        "deepseek-v4.1-flash": {
          "name": "DeepSeek V4.1 Flash"
        },
        "glm-5.3-flash": {
          "name": "GLM 5.3 Flash"
        },
        "mimo-v2.6-pro": {
          "name": "Mimo V2.6 Pro"
        },
        "gpt-5.6-luna": {
          "name": "GPT 5.6 Luna"
        },
        "gpt-6-luna": {
          "name": "GPT 6 Luna"
        }
      }
    }
  },
  "permission": {
    "*": "allow",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "bot/.bot-key": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny"
    },
    "edit": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "bot/.bot-key": "deny"
    },
    "bash": {
      "*": "allow",
      "git commit *": "allow",
      "git push *": "allow",
      "git reset *": "deny",
      "git clean *": "deny",
      "git rebase *": "deny",
      "git checkout *": "ask",
      "rm -rf *": "deny",
      "sudo *": "deny",
      "shutdown *": "deny",
      "reboot": "deny",
      "mkfs*": "deny",
      "dd *": "deny",
      "chmod 777 *": "deny",
      "curl * | sh": "deny",
      "curl * | bash": "deny",
      "ufw *": "deny",
      "iptables*": "deny",
      "systemctl restart kiira-retry-proxy": "allow",
      "systemctl restart kiira-retry-proxy *": "allow",
      "systemctl status kiira-retry-proxy *": "allow",
      "systemctl status *": "allow",
      "systemctl is-active *": "allow",
      "systemctl is-enabled *": "allow",
      "systemctl list-units *": "allow",
      "systemctl list-timers *": "allow",
      "journalctl *": "allow",
      "docker ps": "allow",
      "docker ps *": "allow",
      "docker logs *": "allow",
      "docker stats *": "allow",
      "docker images": "allow",
      "docker version": "allow",
      "df -h": "allow",
      "df *": "allow",
      "free -h": "allow",
      "free *": "allow",
      "uptime": "allow",
      "du *": "allow",
      "top -b *": "allow",
      "ps *": "allow",
      "systemctl cat *": "deny",
      "systemctl show *": "deny",
      "cat /proc/*/environ": "deny",
      "docker inspect *": "deny",
      "docker exec *": "deny",
      "docker cp *": "deny",
      "docker commit *": "deny",
      "docker system prune*": "deny",
      "docker volume prune*": "deny",
      "systemctl start kiira-retry-proxy": "allow",
      "systemctl stop kiira-retry-proxy": "ask",
      "systemctl restart *": "ask",
      "systemctl stop *": "deny",
      "systemctl disable *": "ask",
      "systemctl mask *": "ask",
      "pm2 *": "ask",
      "pm2 restart protogon-bot": "ask",
      "pm2 restart protogon": "ask",
      "pm2 status": "allow",
      "pm2 list": "allow",
      "pm2 logs *": "ask",
      "convex deploy": "ask",
      "convex deploy *": "ask",
      "npx convex deploy": "ask",
      "npx convex deploy *": "ask",
      "bunx convex deploy": "ask",
      "bunx convex deploy *": "ask",
      "bun convex deploy": "ask",
      "bun convex deploy *": "ask",
      "kill *": "ask"
    },
    "webfetch": "allow",
    "external_directory": {
      "**": "deny"
    }
  }
}
