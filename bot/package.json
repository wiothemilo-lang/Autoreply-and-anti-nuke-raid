{
  "name": "protogon-bot",
  "private": true,
  "version": "1.0.0",
  "description": "Protogon Discord bot — auto reply, prefix + slash commands, anti-nuke raid protection",
  "type": "commonjs",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "start:gc": "node --expose-gc src/index.js",
    "register": "node src/register-slash.js",
    "deploy:commands": "node src/register-slash.js",
    "pack:host": "node scripts/pack-host.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.9",
    "convex": "^1.46.0",
    "discord.js": "^14.27.0"
  }
}
