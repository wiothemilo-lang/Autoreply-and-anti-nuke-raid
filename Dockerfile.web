# Dockerfile.web — đóng gói DASHBOARD (frontend) cho Dokploy.
# Bot Discord KHÔNG nằm trong image này — bot tiếp tục chạy trực tiếp bằng Bun
# trên VPS (process riêng, không bọc Docker — tránh phức tạp hóa).
#
# Build 2 giai đoạn (multi-stage):
#   1. node:bun  → cài deps + vite build → dist/ (file tĩnh)
#   2. nginx     → chỉ copy dist/ → serve cực nhẹ (~25MB RAM)
#
# Lưu ý build-args (điền trong Dokploy → tab Build → Build Arguments):
#   VITE_CONVEX_URL        URL deployment Convex thật (bắt buộc — build fail
#                          closed nếu thiếu, không tự trỏ production)
#   VITE_DISCORD_CLIENT_ID application id bot (để nút đăng nhập Discord hoạt động)
#   DISCORD_CLIENT_ID      shim scripts/build.mjs tự chuyển thành VITE_DISCORD_CLIENT_ID

# ── Giai đoạn 1: build ─────────────────────────────────────────
FROM oven/bun:1 AS build
WORKDIR /app

# Copy manifest trước để cache layer (deps không đổi → không cài lại)
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile

# Copy phần còn lại rồi build (build-args từ Dokploy tới đây qua ENV)
COPY index.html vite.config.ts tailwind.config.ts postcss.config.js tsconfig*.json ./
COPY scripts/build.mjs ./scripts/build.mjs
COPY src ./src
COPY public ./public
COPY convex ./convex

ARG VITE_CONVEX_URL=""
ARG VITE_DISCORD_CLIENT_ID=""
ARG DISCORD_CLIENT_ID=""
ENV VITE_CONVEX_URL=$VITE_CONVEX_URL \
    VITE_DISCORD_CLIENT_ID=$VITE_DISCORD_CLIENT_ID \
    DISCORD_CLIENT_ID=$DISCORD_CLIENT_ID
RUN bun run build

# ── Giai đoạn 2: serve ─────────────────────────────────────────
FROM nginx:1.27-alpine
# Security headers + CSP. Viết ra file riêng rồi `include` ở CẢ server lẫn
# /assets/ vì nginx KHÔNG kế thừa add_header khi location có add_header riêng
# (location /assets/ có Cache-Control → nếu không include lại sẽ mất hết header).
# CSP: script-src chỉ 'self' (không inline script trong bundle Vite; thẻ
# ld+json là data-block nên không bị chặn). style-src cần 'unsafe-inline' vì
# thư viện UI (sonner/radix) chèn <style> runtime. connect-src mở cho Convex
# (https + wss) và discord.com (form-action OAuth).
RUN printf '%s\n' \
  "add_header Content-Security-Policy \"default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://*.convex.cloud https://*.convex.site wss://*.convex.cloud wss://*.convex.site https://discord.com; object-src 'none'; base-uri 'self'; form-action 'self' https://discord.com; frame-ancestors 'none'; worker-src 'self' blob:; manifest-src 'self'\" always;" \
  "add_header X-Content-Type-Options \"nosniff\" always;" \
  "add_header X-Frame-Options \"DENY\" always;" \
  "add_header Referrer-Policy \"strict-origin-when-cross-origin\" always;" \
  "add_header Permissions-Policy \"geolocation=(), microphone=(), camera=(), payment=()\" always;" \
  "add_header Strict-Transport-Security \"max-age=31536000; includeSubDomains\" always;" \
  > /etc/nginx/security-headers.conf \
  && printf '%s\n' \
  "server {" \
  "  listen 80;" \
  "  server_name _;" \
  "  root /usr/share/nginx/html;" \
  "  index index.html;" \
  "  include /etc/nginx/security-headers.conf;" \
  "  location ~ ^/(auth|discord/callback|admin|stats|status|monitor|terms|privacy|data-deletion)/?$ {" \
  "    try_files /index.html =404;" \
  "    include /etc/nginx/security-headers.conf;" \
  "    add_header X-Robots-Tag \"noindex, nofollow\" always;" \
  "  }" \
  "  location ~ ^/dashboard(?:/.+)?/?$ {" \
  "    try_files /index.html =404;" \
  "    include /etc/nginx/security-headers.conf;" \
  "    add_header X-Robots-Tag \"noindex, nofollow\" always;" \
  "  }" \
  "  location / { try_files \$uri \$uri/ =404; }" \
  "  error_page 404 /404.html;" \
  "  location /assets/ {" \
  "    include /etc/nginx/security-headers.conf;" \
  "    expires 30d;" \
  "    add_header Cache-Control \"public, immutable\";" \
  "  }" \
  "}" > /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
